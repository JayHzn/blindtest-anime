{
  "name": "@blindtest/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "catalogue:sync": "tsx scripts/sync/index.ts",
    "catalogue:check": "tsx scripts/check-catalogue.ts",
    "smoke": "tsx scripts/smoke-game.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "socket.io": "^4.8.4"
  }
}
